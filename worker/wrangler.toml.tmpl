# 배포 때 worker.yml이 __ACCOUNT__·__BUCKET__·__KV__를 채워 wrangler.toml로 만듦 (wrangler.toml은 커밋하지 않음)
name = "lcf-ask"
main = "src/index.js"
compatibility_date = "2026-09-01"
account_id = "__ACCOUNT__"
workers_dev = true

[vars]
ALLOW_ORIGIN = "https://flytothejy.github.io"
MODEL_CLASSIFY = "claude-haiku-5-5"
MODEL_ANSWER = "claude-sonnet-5-5"

[[r2_buckets]]
binding = "BUCKET"
bucket_name = "__BUCKET__"

[[kv_namespaces]]
binding = "LIMITS"
id = "__KV__"

# 한도 세기 (정확하게) — 무료 플랜은 SQLite 기반 Durable Object
[[durable_objects.bindings]]
name = "QUOTA"
class_name = "Quota"

[[durable_objects.bindings]]
name = "USAGE"
class_name = "Usage"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["Quota"]

[[migrations]]
tag = "v2"
new_sqlite_classes = ["Usage"]

# 요청 기록 (대시보드 Workers 로그에서 최근 며칠)
[observability]
enabled = true
